DATABASE_URL=postgresql://user:password@localhost:5432/medis_dev
NODE_ENV=development
PORT=3008
JWT_SECRET=your-secret-key-here-change-in-production
CORS_ORIGIN=http://localhost:5173

# Clave para cifrar credenciales SISPRO (AES-256-GCM). Usar un valor aleatorio largo.
# Si falta, se usa JWT_SECRET como fallback.
# IMPORTANTE: una vez hay credenciales SISPRO guardadas, NO cambiar este valor
# (ni JWT_SECRET si se usó el fallback) — las credenciales cifradas quedarían irrecuperables.
SISPRO_SECRET=
