FROM node:20-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY medisxime-landing/package.json medisxime-landing/package.json
COPY medisxime-landing/tsconfig*.json medisxime-landing/eslint.config.js medisxime-landing/vite.config.ts medisxime-landing/index.html ./medisxime-landing/
COPY medisxime-landing/public ./medisxime-landing/public
COPY medisxime-landing/src ./medisxime-landing/src

RUN pnpm install --frozen-lockfile
RUN pnpm --filter medisxime-landing build

FROM nginx:1.27-alpine AS runtime

ENV BACKEND_URL="http://127.0.0.1:3000"

COPY docker/frontend-nginx.conf.template /etc/nginx/templates/default.conf.template
COPY docker/frontend-entrypoint.sh /docker-entrypoint.sh
COPY --from=build /app/medisxime-landing/dist /usr/share/nginx/html

RUN chmod +x /docker-entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/docker-entrypoint.sh"]