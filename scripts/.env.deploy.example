# Copiar a scripts/.env.deploy (gitignored — NUNCA commitear ese archivo).
# deploy-medisxime.ps1 lee estos valores; los que falten y no se pasen como
# parametro (-EmailPassword, -AdminPassword) hacen fallar el script con un
# mensaje claro. JWT_SECRET/SISPRO_SECRET se generan y persisten solos si se
# dejan vacios/ausentes — no hace falta llenarlos a mano.

EMAIL_PASSWORD=
ADMIN_PASSWORD=
JWT_SECRET=
SISPRO_SECRET=
